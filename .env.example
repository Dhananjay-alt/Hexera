# ---------------------------------------------------------------------------
# Hexera configuration. Copy to .env. Everything works with no .env at all
# (local mode: simulated HCS/HTS + mirror node served by the facilitator).
# ---------------------------------------------------------------------------

# local | testnet
HEXERA_MODE=local

FACILITATOR_PORT=4020
FACILITATOR_URL=http://localhost:4020
ADMIN_TOKEN=change-me

# --- Hedera (testnet mode). `npm run setup:testnet` generates all of these. ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com
HEXERA_TREASURY_ID=
# two of the three keys of the treasury's 2-of-3 KeyList, comma separated
HEXERA_TREASURY_KEYS=
# leave empty to have setup create a test stablecoin (hUSD, 6 decimals)
HEXERA_TOKEN_ID=
HEXERA_SPENT_TOPIC_ID=
HEXERA_LEDGER_TOPIC_ID=
# id:hedera-account:Display name, comma separated (account optional in local mode)
HEXERA_MERCHANTS=daily-ledger::The Daily Ledger,quant-feed::Quant Feed
# demo users for the reader app / demo script (testnet only)
DEMO_USER_1_ID=
DEMO_USER_1_KEY=
DEMO_USER_2_ID=
DEMO_USER_2_KEY=

# --- Protocol ---
EPOCH_SECONDS=86400
EPOCH_GRACE_SECONDS=86400
PAYOUT_INTERVAL_SECONDS=180

# --- Spending controls (base units, 6 decimals) ---
# per account per day without World ID
FREE_DAILY_LIMIT_BASE=1000000
# per unique human per day (World ID Proof of Human)
HUMAN_DAILY_CAP_BASE=20000000

# --- World ID (IDKit v4) ---
# dev = simulator button, no World App needed; production = real proofs
WORLD_ID_MODE=dev
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=hexera-deposit

# --- Reader app ---
NEXT_PUBLIC_FACILITATOR_URL=http://localhost:4020
NEXT_PUBLIC_PUBLISHERS=http://localhost:4021,http://localhost:4022
NEXT_PUBLIC_AUDIT_URL=http://localhost:3001
